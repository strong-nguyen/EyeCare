<Window x:Class="EyeCareUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EyeCareUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="50"/>
      <RowDefinition Height="50"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <Button Grid.Row="0" Width="150" Click="Button_Click">Setting Window</Button>
    <Button Grid.Row="1" Width="150" Click="Button_Click_1">About Window</Button>
    <Button Grid.Row="2" Width="150" Click="Button_Click_2">Countdown Window</Button>
  </Grid>
</Window>
