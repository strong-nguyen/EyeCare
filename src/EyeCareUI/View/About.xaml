<Window x:Class="EyeCareUI.View.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EyeCareUI.View"
        mc:Ignorable="d"
        Title="About" Height="700" Width="800" MinHeight="700" MinWidth="800"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    
    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Take A Break" FontSize="14" FontWeight="Bold"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <TextBlock Text="Version: " FontSize="14"/>
        <TextBlock Text="{Binding Version}"  FontSize="14"/>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="Developed by Nguyen Van Trong. All rights reserved." FontSize="14"/>
      <TextBlock FontStyle="Italic" FontSize="14" Grid.Row="3">
          It is totally free, no-ads and if you find it useful, you could buy me a coffee via VND or USDT addresses below:
      </TextBlock>
    </Grid>


    <Button Grid.Row="2" HorizontalAlignment="Right" Width="120" Height="40" FontSize="14" Style="{StaticResource MyButton}" Command="{Binding ThankYouCommand}">Thank you</Button>

    <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Vietnam Bank Transfer" TextAlignment="Center" FontWeight="Bold"/>
      <Image Grid.Row="1" Grid.Column="0" Source="pack://application:,,,/Images/tpb.jpeg"></Image>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="USDT via BNB Smart Chain (BEP20)" TextAlignment="Center" FontWeight="Bold"/>
      <Image Grid.Row="1" Grid.Column="1" Source="pack://application:,,,/Images/usdt.jpeg"></Image>
    </Grid>
  </Grid>
</Window>
