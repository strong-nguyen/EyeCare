<Window x:Class="EyeCareUI.View.Setting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EyeCareUI.View"
        mc:Ignorable="d"
        Title="Setting" Height="450" Width="800" MinHeight="450" MinWidth="800">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid MinWidth="500" MinHeight="300" Margin="0,0,0,40">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition MinWidth="100" />
        <ColumnDefinition MinWidth="100" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Break After: " FontWeight="Bold" FontSize="14" Margin="10"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Break In: " FontWeight="Bold" FontSize="14" Margin="10"/>
      <TextBox Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="10" TextAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="10" TextAlignment="Center"/>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="minutes" FontSize="14" Margin="10"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes" FontSize="14" Margin="10"/>
    </Grid>
    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
      <Button Background="Blue" Foreground="White" Height="40" FontSize="14" Width="100" Margin="0,0,20,0">OK</Button>
      <Button Background="White" Height="40" FontSize="14" Width="100">Cancel</Button>
    </StackPanel>
  </StackPanel>
</Window>
