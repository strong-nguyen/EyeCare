<Window x:Class="EyeCareUI.View.Setting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EyeCareUI.View"
        mc:Ignorable="d"
        Title="Setting" Height="450" Width="600" MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid MinWidth="500" MinHeight="300" Margin="0,0,0,40">
      <Grid.RowDefinitions>
        <RowDefinition Height="80" />
        <RowDefinition Height="80" />
        <RowDefinition Height="80"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition MinWidth="100" />
        <ColumnDefinition MinWidth="100" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Take A Break After" FontWeight="Bold" FontSize="18" Margin="10" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Break In" FontWeight="Bold" FontSize="18" Margin="10" VerticalAlignment="Center"/>
      <TextBox Grid.Row="0" Grid.Column="1" Margin="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" Height="60" BorderThickness="0,0,0,1" BorderBrush="Black" Background="Transparent" FontWeight="Bold" FontSize="18" Foreground="Green" TextWrapping="NoWrap" AcceptsReturn="False" Text="{Binding BreakTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBox Grid.Row="1" Grid.Column="1" Margin="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" Height="60" BorderThickness="0,0,0,1" BorderBrush="Black" Background="Transparent" FontWeight="Bold" FontSize="18" Foreground="Orange" TextWrapping="NoWrap" AcceptsReturn="False" Text="{Binding RelaxTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="minutes" FontSize="18" Margin="10" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes" FontSize="18" Margin="10" VerticalAlignment="Center"/>
      
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Startup with Windows" FontWeight="Bold" FontSize="18" Margin="10" VerticalAlignment="Center"/>
      <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding IsAutoStart}"/>
    </Grid>
    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
      <!--<Button Background="Blue" Foreground="White" Height="40" FontSize="14" Width="100" Margin="0,0,20,0" Command="{Binding OKCommand}">OK</Button>
      <Button Background="White" Height="40" FontSize="14" Width="100" Command="{Binding CancelCommand}">Cancel</Button>-->
      <Button Style="{StaticResource MyButton}" Height="40" FontSize="14" Width="100" Margin="0,0,20,0" Command="{Binding OKCommand}">OK</Button>
      <Button Style="{StaticResource MyButton}" Background="#42444d" Height="40" FontSize="14" Width="100" Command="{Binding CancelCommand}">Cancel</Button>
    </StackPanel>
  </StackPanel>
</Window>
